&НаКлиенте
Процедура Сдаться(Команда)

	Если СтатусПартии <> "игра" И СтатусПартии <> "ожидание" Тогда
		Возврат;
	КонецЕсли;

	Если РежимИгры = "пасьянс" Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеВопросаНовыйПасьянс", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Сдать пасьянс и раздать заново?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Возврат;
	КонецЕсли;

	Если РежимИгры = "локально" Тогда
		СтатусПартии = ?(ХодБелых, "победаЧерных", "победаБелых");
		ОбновитьОтображение();
		ПоказатьОкноПобедыЕслиНужно();
		Возврат;
	КонецЕсли;

	Если РежимИгры = "бот" Тогда
		ОтключитьОбработчикОжидания("ХодБотаОбработчик");
		СтатусПартии = "победаЧерных";
		ОбновитьОтображение();
		ПоказатьОкноПобедыЕслиНужно();
		Возврат;
	КонецЕсли;

	Если РежимИгры <> "хост" И РежимИгры <> "гость" Тогда
		Возврат;
	КонецЕсли;

	Если ТипИгры = "дурак" Тогда
		ОбработатьСдачуИлиУходДурака("сдался", Истина);
		Возврат;
	КонецЕсли;

	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если МойЦветБелые Тогда
		Состояние.статус = "победаЧерных";
		Состояние.сообщение = ИмяИгрока + " сдался (белые)";
	Иначе
		Состояние.статус = "победаБелых";
		Состояние.сообщение = ИмяИгрока + " сдался (чёрные)";
	КонецЕсли;
	Состояние.версия = Состояние.версия + 1;
	Если ЗаписатьСостояниеВФайл(Состояние) Тогда
		ПрименитьСостояниеНаКлиенте(Состояние);
		ОбновитьОтображение();
		ПоказатьОкноПобедыЕслиНужно();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СделатьХод(Команда)

	ИзКлетки = НотацияВКоординатыНаСервере(КлеткаИз);
	ВКлетки = НотацияВКоординатыНаСервере(КлеткаВ);
	Если Не ИзКлетки.Успех Или Не ВКлетки.Успех Тогда
		ПоказатьПредупреждение(, "Укажите клетки как a3 и b4.");
		Возврат;
	КонецЕсли;

	ВыбранаСтрока = ИзКлетки.Строка;
	ВыбранаКолонка = ИзКлетки.Колонка;
	ОбработатьКликПоКлетке(ВКлетки.Строка, ВКлетки.Колонка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОпросПартииОбработчик() Экспорт

	Если РежимИгры <> "хост" И РежимИгры <> "гость" Тогда
		Возврат;
	КонецЕсли;
	Если ЦепочкаВзятия Тогда
		Возврат;
	КонецЕсли;

	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЗаписатьСвойПульс();
	Если ТипИгры = "дурак" Тогда
		Если ОбработатьПропавшихИгроковДурака(Состояние) Тогда
			Состояние = ПрочитатьСостояниеИзФайла();
			Если Состояние = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		// Автоход только из ОбновитьТаймерХодаДуракаОбработчик после локальных 60 с.
	КонецЕсли;

	Если Состояние.версия = ВерсияПартии И Состояние.доска = Доска И Состояние.статус = СтатусПартии Тогда
		Возврат;
	КонецЕсли;

	БылСтатус = СтатусПартии;
	БылХод = ПоследнийХод;
	ПрименитьСостояниеНаКлиенте(Состояние);
	СброситьВыбор();
	ОбновитьОтображение();
	Если ТипИгры = "дурак" И Не ПустаяСтрока(ПоследнийХод) И ПоследнийХод <> БылХод Тогда
		Если СтрНайти(НРег(ПоследнийХод), "сдался") > 0
			Или СтрНайти(НРег(ПоследнийХод), "закрыл") > 0
			Или СтрНайти(НРег(ПоследнийХод), "отключился") > 0 Тогда
			ПоказатьОповещениеПользователя("Дурак", , ПоследнийХод);
		КонецЕсли;
	КонецЕсли;
	Если (СтатусПартии = "победаБелых" Или СтатусПартии = "победаЧерных" Или СтатусПартии = "ничья")
		И БылСтатус <> СтатусПартии Тогда
		ПоказатьОкноПобедыЕслиНужно();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьОпрос()

	ОтключитьОбработчикОжидания("ОпросПартииОбработчик");
	ПодключитьОбработчикОжидания("ОпросПартииОбработчик", 1.5, Ложь);
	ПодключитьТаймерОтображенияХодаДурака();

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьТаймерОтображенияХодаДурака()

	ОтключитьОбработчикОжидания("ОбновитьТаймерХодаДуракаОбработчик");
	Если ТипИгры = "дурак" И СтатусПартии = "игра" Тогда
		ПодключитьОбработчикОжидания("ОбновитьТаймерХодаДуракаОбработчик", 1, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаймерХодаДуракаОбработчик() Экспорт

	Если ТипИгры <> "дурак" Или СтатусПартии <> "игра" Тогда
		ОтключитьОбработчикОжидания("ОбновитьТаймерХодаДуракаОбработчик");
		Возврат;
	КонецЕсли;

	ОбновитьЛокальныйТаймерХодаДурака();
	Сек = СекундЛокальногоТаймераДурака();
	Лимит = ЛимитСекундХодаДуракаНаСервере();
	База = ?(ПустаяСтрока(ПоследнийХод), "Ход", ПоследнийХод);
	ТекстХода = База + " · таймер " + Формат(Сек, "ЧН=0; ЧГ=0") + "/" + Формат(Лимит, "ЧГ=0") + " с";

	Если Сек > 0 Тогда
		Возврат;
	КонецЕсли;

	// По истечении 60 с — проигрыш того, чей ход (без автохода).
	// Хост тоже фиксирует просрочку, если соперник «завис».
	ИндексХода = ИндексХодаДуракаНаСервере(Доска);
	МожноФиксировать = (ИндексХода = МойИндексИгрока)
		Или (РежимИгры = "хост")
		Или РежимИгры = "локально" Или РежимИгры = "бот";
	Если Не МожноФиксировать Тогда
		Возврат;
	КонецЕсли;

	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		Состояние = ПрочитатьСостояниеИзФайла();
		Если Состояние <> Неопределено Тогда
			ОбработатьПросрочкуХодаДурака(Состояние);
		КонецЕсли;
	ИначеЕсли РежимИгры = "локально" Или РежимИгры = "бот" Тогда
		Результат = ВывестиИгрокаДуракаНаСервере(Доска, ИндексХода,
			"проиграл по времени (" + Формат(Лимит, "ЧГ=0") + " с)");
		Если Результат.Ок Тогда
			Доска = Результат.Доска;
			СтатусПартии = Результат.Статус;
			Если Не ПустаяСтрока(Результат.Описание) Тогда
				ПоследнийХод = Результат.Описание;
			КонецЕсли;
			ХодБелых = ХодБелыхДуракаНаСервере(Доска);
			СброситьЛокальныйТаймерХодаДурака();
			ОбновитьОтображение();
			Если Не Результат.Продолжается Тогда
				ПоказатьОкноПобедыЕслиНужно();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЛокальныйТаймерХодаДурака()

	Если СтатусПартии <> "игра" Или ТипИгры <> "дурак" Тогда
		Возврат;
	КонецЕсли;
	НовыйId = ИдентификаторХодаДуракаНаСервере(Доска);
	Если НовыйId <> ДуракTurnId Или ДуракХодНачатМс <= 0 Тогда
		ДуракTurnId = НовыйId;
		ДуракХодНачатМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция СекундЛокальногоТаймераДурака()

	Лимит = ЛимитСекундХодаДуракаНаСервере();
	Если ДуракХодНачатМс <= 0 Тогда
		Возврат Лимит;
	КонецЕсли;
	Прошло = Цел((ТекущаяУниверсальнаяДатаВМиллисекундах() - ДуракХодНачатМс) / 1000);
	Осталось = Лимит - Прошло;
	Если Осталось < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Осталось;

КонецФункции

&НаКлиенте
Процедура СброситьЛокальныйТаймерХодаДурака()

	ДуракTurnId = ИдентификаторХодаДуракаНаСервере(Доска);
	ДуракХодНачатМс = ТекущаяУниверсальнаяДатаВМиллисекундах();

КонецПроцедуры

&НаКлиенте
Функция ОбработатьПросрочкуХодаДурака(Состояние)

	Если Состояние = Неопределено Или Состояние.статус <> "игра" Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбновитьЛокальныйТаймерХодаДурака();
	Если СекундЛокальногоТаймераДурака() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ИндексХода = ИндексХодаДуракаНаСервере(Состояние.доска);
	Результат = ВывестиИгрокаДуракаНаСервере(Состояние.доска, ИндексХода,
		"проиграл по времени (" + Формат(ЛимитСекундХодаДуракаНаСервере(), "ЧГ=0") + " с)");
	Если Не Результат.Ок Тогда
		Возврат Ложь;
	КонецЕсли;

	Состояние.доска = Результат.Доска;
	Состояние.статус = Результат.Статус;
	Состояние.сообщение = Результат.Описание;
	Состояние.последнийХод = Результат.Описание;
	Состояние.версия = Состояние.версия + 1;
	Состояние.ходБелых = ХодБелыхДуракаНаСервере(Состояние.доска);
	Если Не ЗаписатьСостояниеВФайл(Состояние) Тогда
		Возврат Ложь;
	КонецЕсли;
	ПрименитьСостояниеНаКлиенте(Состояние);
	СброситьЛокальныйТаймерХодаДурака();
	ОбновитьОтображение();
	Если Не Результат.Продолжается Тогда
		ПоказатьОкноПобедыЕслиНужно();
	Иначе
		ПоказатьОповещениеПользователя("Дурак", , Результат.Описание);
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаКлиенте
Функция ПроверитьПараметрыСети(НужнаПапкаОбязательно)

	Если ПустаяСтрока(СокрЛП(ИмяИгрока)) Тогда
		ПоказатьПредупреждение(, "Укажите ваше имя.");
		Возврат Ложь;
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(КодПартии)) Тогда
		ПоказатьПредупреждение(, "Укажите код партии.");
		Возврат Ложь;
	КонецЕсли;
	Если НужнаПапкаОбязательно Или Истина Тогда
		Если ПустаяСтрока(СокрЛП(ПутьКПапке)) Тогда
			ПоказатьПредупреждение(, "Укажите общую папку.");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;

КонецФункции


	Элементы.РазмерКолоды.СписокВыбора.Добавить("52", "52 карты");
	ВыборПасьянса = "";
	ИсторияОтменыПасьянса.Очистить();
	ОбновитьВидимостьНастроекНаСервере();
	ОбновитьДоскуНаСервере();

КонецПроцедуры


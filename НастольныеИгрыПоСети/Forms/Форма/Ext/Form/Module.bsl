Функция ИгрокУжеВнеМатчаДуракаНаСервере(ДоскаПараметр, ИндексИгрока)

	Состояние = Логика().СостояниеДуракаИзСтроки(ДоскаПараметр);
	Если ИндексИгрока < 0 Или ИндексИгрока >= Состояние.n Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Состояние.out) = Тип("Массив") И ИндексИгрока < Состояние.out.Количество() Тогда
		Возврат Состояние.out[ИндексИгрока];
	КонецЕсли;
	Возврат Ложь;


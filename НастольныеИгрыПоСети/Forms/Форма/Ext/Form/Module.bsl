	Каталог = ПутьКПапке;
	Если Прав(Каталог, 1) <> "\" И Прав(Каталог, 1) <> "/" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	Возврат Каталог + ИмяФайла;


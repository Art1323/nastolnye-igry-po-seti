#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипИгрыПриИзменении(Элемент)

	Если РежимИгры = "гость" Или РежимИгры = "хост" Тогда
		ТипИгры = ТипИгрыСетевой;
		ОбновитьВидимостьНастроекНаСервере();
		ПоказатьПредупреждение(, "Нельзя сменить игру во время сетевой партии.");
		Возврат;
	КонецЕсли;
	ОтключитьОбработчикОжидания("ХодБотаОбработчик");
	Если ТипИгры = "пасьянс" Тогда
		НачатьПасьянс();
		Возврат;
	КонецЕсли;
	Если РежимИгры = "пасьянс" Тогда
		РежимИгры = "";
	КонецЕсли;
	Если РежимИгры = "локально" Или РежимИгры = "бот" Тогда
		НачатьНовуюЛокальнуюРасстановку();
		Возврат;
	КонецЕсли;
	Если ТипИгры = "шахматы" Тогда
		Доска = НоваяДоскаШахматНаСервере();
		ОбязательноеВзятие = Ложь;
	ИначеЕсли ТипИгры = "дурак" Тогда
		Доска = НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак);
		ОбязательноеВзятие = Ложь;
		ХодБелых = Истина;
		МойИндексИгрока = 0;
	Иначе
		Доска = НоваяДоскаНаСервере();
		ХодБелых = Истина;
	КонецЕсли;
	РокировкаПрава = "KQkq";
	ПолеEP = "";
	Если ТипИгры <> "дурак" Тогда
		ХодБелых = Истина;
	КонецЕсли;
	СтатусПартии = "";
	ПоследнийХод = "";
	ВыборПасьянса = "";
	СброситьВыбор();
	ОбновитьВидимостьНастроекНаСервере();
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура НастройкиДуракаПриИзменении(Элемент)

	Если ТипИгры <> "дурак" Тогда
		Возврат;
	КонецЕсли;
	Если РежимИгры = "гость" Или РежимИгры = "хост" Тогда
		ПоказатьПредупреждение(, "Настройки дурака задаёт хост при создании партии.");
		ОбновитьВидимостьНастроекНаСервере();
		Возврат;
	КонецЕсли;
	Если РежимИгры = "локально" Или РежимИгры = "бот" Тогда
		НачатьНовуюЛокальнуюРасстановку();
		Возврат;
	КонецЕсли;
	Доска = НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак);
	ХодБелых = Истина;
	СтатусПартии = "";
	ПоследнийХод = "";
	СброситьВыбор();
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура ОбязательноеВзятиеПриИзменении(Элемент)

	Если ТипИгры = "шахматы" Или ТипИгры = "пасьянс" Или ТипИгры = "дурак" Тогда
		ОбязательноеВзятие = Ложь;
		Возврат;
	КонецЕсли;
	Если РежимИгры = "гость" Тогда
		ОбязательноеВзятие = Не ОбязательноеВзятие;
		ПоказатьПредупреждение(, "Правило задаёт хост при создании партии.");
		Возврат;
	КонецЕсли;
	СброситьВыбор();
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура ДоскаHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	Адрес = ИзвлечьАдресИзСобытияHTML(ДанныеСобытия);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Маркер = "cell:";
	Позиция = СтрНайти(НРег(Адрес), Маркер);
	Если Позиция = 0 Тогда
		Возврат;
	КонецЕсли;

	СтандартнаяОбработка = Ложь;
	Хвост = Сред(Адрес, Позиция + СтрДлина(Маркер));
	Части = СтрРазделить(Хвост, ":");
	Если Части.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	Попытка
		СтрокаКлетки = Число(Части[0]);
		КолонкаКлетки = Число(Части[1]);
	Исключение
		Возврат;
	КонецПопытки;

	ОбработатьКликПоКлетке(СтрокаКлетки, КолонкаКлетки);

КонецПроцедуры

&НаКлиенте
Функция ИзвлечьАдресИзСобытияHTML(ДанныеСобытия)

	Адрес = "";
	Ид = "";
	Если ТипЗнч(ДанныеСобытия) = Тип("Структура") Тогда
		Если ДанныеСобытия.Свойство("Href") Тогда
			Адрес = Строка(ДанныеСобытия.Href);
		КонецЕсли;
		Если ПустаяСтрока(Адрес) И ДанныеСобытия.Свойство("Anchor") Тогда
			Адрес = Строка(ДанныеСобытия.Anchor);
		КонецЕсли;
		Если ДанныеСобытия.Свойство("ElementId") Тогда
			Ид = СокрЛП(Строка(ДанныеСобытия.ElementId));
		КонецЕсли;
	Иначе
		Попытка
			Адрес = Строка(ДанныеСобытия.Href);
		Исключение
			Адрес = "";
		КонецПопытки;
	КонецЕсли;

	// id вида c_83_2 надёжнее, если клик попал во вложенный текст карты.
	Если Лев(НРег(Ид), 2) = "c_" Тогда
		Если ПустаяСтрока(Адрес) Или СтрНайти(НРег(Адрес), "cell:") = 0 Тогда
			Адрес = "cell:" + СтрЗаменить(Сред(Ид, 3), "_", ":");
		КонецЕсли;
	КонецЕсли;
	Возврат Адрес;

КонецФункции

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПапку(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = "Общая папка для партии";
	Если Не ПустаяСтрока(ПутьКПапке) Тогда
		Диалог.Каталог = ПутьКПапке;
	КонецЕсли;
	Если Диалог.Выбрать() Тогда
		ПутьКПапке = Диалог.Каталог;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИгру(Команда)

	Если ТипИгры = "пасьянс" Тогда
		ПоказатьПредупреждение(, "Пасьянс — одиночная игра. Выберите его в списке — партия начнётся сразу.");
		НачатьПасьянс();
		Возврат;
	КонецЕсли;

	Если Не ПроверитьПараметрыСети(Истина) Тогда
		Возврат;
	КонецЕсли;

	ПутьФайла = ПутьФайлаПартии();
	Если ФайлСуществуетКлиент(ПутьФайла) Тогда
		Оповещение = Новый ОписаниеОповещения("СоздатьИгруПослеВопроса", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, "Файл партии уже есть. Перезаписать?", РежимДиалогаВопрос.ДаНет);
		Возврат;
	КонецЕсли;

	СоздатьИгруЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИгруПослеВопроса(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	СоздатьИгруЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьИгруЗавершение()

	УдалитьФайлыПартииПоКоду();
	Состояние = СоздатьСостояниеПартииНаСервере(КодПартии, ИмяИгрока, ОбязательноеВзятие, ТипИгры,
		РазмерКолодыЧислом(), ПереводнойДурак);
	Если ТипИгры = "дурак" Тогда
		ИгрокиСтарт = Новый Массив;
		ИгрокиСтарт.Добавить(ИмяИгрока);
		Состояние.Вставить("игроки", ИгрокиСтарт);
		Состояние.доска = ОбновитьСоставЛоббиДуракаНаСервере(Состояние.доска, ИгрокиСтарт);
		Состояние.сообщение = "В лобби: " + ИмяИгрока;
		Состояние.последнийХод = "Подключились: " + ИмяИгрока + " (хост)";
	КонецЕсли;
	Если Не ЗаписатьСостояниеВФайл(Состояние) Тогда
		Возврат;
	КонецЕсли;

	РежимИгры = "хост";
	ТипИгрыСетевой = ТипИгры;
	МойЦветБелые = Истина;
	МойИндексИгрока = 0;
	ПрименитьСостояниеНаКлиенте(Состояние);
	ЦепочкаВзятия = Ложь;
	ВзятыеКлетки = "|";
	СброситьВыбор();
	ОбновитьБлокировкуТипаИгрыНаСервере();
	ПодключитьОпрос();
	ЗаписатьСвойПульс();
	Если ТипИгры = "дурак" Тогда
		ПоказатьПредупреждение(, "Лобби создано. Ждите игроков (до 4). Когда есть хотя бы один — «Начать матч».");
	Иначе
		ПоказатьПредупреждение(, "Партия создана (" + ТипИгры + "). Соперник: та же папка и код — «Подключиться».");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Команда)

	Если ТипИгры = "пасьянс" Тогда
		ПоказатьПредупреждение(, "Пасьянс — одиночная игра, подключение по сети не нужно.");
		НачатьПасьянс();
		Возврат;
	КонецЕсли;

	Если Не ПроверитьПараметрыСети(Ложь) Тогда
		Возврат;
	КонецЕсли;

	Найдено = НайтиПартиюДляПодключения();
	Если Найдено = Неопределено Тогда
		ПоказатьПредупреждение(, "Файл партии не найден. Проверьте папку, код и что хост нажал «Создать игру».");
		Возврат;
	КонецЕсли;

	Если Найдено.Проблема <> "" Тогда
		ПоказатьПредупреждение(, Найдено.Проблема);
		Возврат;
	КонецЕсли;

	ТипИгры = Найдено.ТипИгры;
	ТипИгрыСетевой = ТипИгры;

	Актуальное = ПрочитатьСостояниеПоТипу(ТипИгры);
	Если Актуальное = Неопределено Или Актуальное.статус <> "ожидание" Тогда
		ПоказатьПредупреждение(, "Партия больше не ждёт игроков.");
		Возврат;
	КонецЕсли;

	Если ТипИгры = "дурак" Тогда
		ПодключитьсяКДураку(Актуальное);
		Возврат;
	КонецЕсли;

	Если Не ПустаяСтрока(Актуальное.имяГостя) Тогда
		ПоказатьПредупреждение(, "В этой партии уже максимальное количество игроков (2). Подключение невозможно.");
		Возврат;
	КонецЕсли;

	Состояние = Актуальное;
	Состояние.имяГостя = ИмяИгрока;
	Состояние.статус = "игра";
	Состояние.сообщение = "Игра началась";
	Состояние.версия = Состояние.версия + 1;
	Если Не ЗаписатьСостояниеВФайл(Состояние) Тогда
		Возврат;
	КонецЕсли;

	РежимИгры = "гость";
	МойЦветБелые = Не Состояние.хостБелые;
	МойИндексИгрока = 1;
	ПрименитьСостояниеНаКлиенте(Состояние);
	ЦепочкаВзятия = Ложь;
	ВзятыеКлетки = "|";
	СброситьВыбор();
	ОбновитьБлокировкуТипаИгрыНаСервере();
	ПодключитьОпрос();

КонецПроцедуры

&НаКлиенте
Процедура ПодключитьсяКДураку(Актуальное)

	Игроки = ИгрокиПартии(Актуальное);
	МаксИгроков = 4;
	Если Актуальное.Свойство("максИгроков") Тогда
		МаксИгроков = Актуальное.максИгроков;
	КонецЕсли;
	Если Игроки.Количество() >= МаксИгроков Тогда
		ПоказатьПредупреждение(, "В лобби уже " + Формат(МаксИгроков, "ЧГ=0") + " игрока. Подключение невозможно.");
		Возврат;
	КонецЕсли;
	Для Каждого ИмяУже Из Игроки Цикл
		Если ВРег(СокрЛП(ИмяУже)) = ВРег(СокрЛП(ИмяИгрока)) Тогда
			ПоказатьПредупреждение(, "Игрок с таким именем уже в лобби. Смените имя.");
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Размер = ?(Актуальное.Свойство("размерКолоды") И Актуальное.размерКолоды = 52, 52, 36);
	Перевод = ?(Актуальное.Свойство("переводной"), Актуальное.переводной, Ложь);
	ТекстПравил = ТекстПравилДуракаНаСервере(Размер, Перевод);
	Оповещение = Новый ОписаниеОповещения("ПослеСогласияПравилДурака", ЭтотОбъект, Актуальное);
	ПоказатьВопрос(Оповещение, ТекстПравил, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Правила партии");

КонецПроцедуры

&НаКлиенте
Процедура ПослеСогласияПравилДурака(Результат, Актуальное) Экспорт

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Актуальное = ПрочитатьСостояниеПоТипу("дурак");
	Если Актуальное = Неопределено Или Актуальное.статус <> "ожидание" Тогда
		ПоказатьПредупреждение(, "Партия уже началась или недоступна.");
		Возврат;
	КонецЕсли;
	Игроки = ИгрокиПартии(Актуальное);
	Если Игроки.Количество() >= 4 Тогда
		ПоказатьПредупреждение(, "Мест больше нет.");
		Возврат;
	КонецЕсли;
	Игроки.Добавить(ИмяИгрока);
	Актуальное.Вставить("игроки", Игроки);
	Если Игроки.Количество() >= 2 Тогда
		Актуальное.имяГостя = Игроки[1];
	КонецЕсли;
	Актуальное.сообщение = "В лобби: " + СтрСоединить(Игроки, ", ");
	Актуальное.последнийХод = "Подключились: " + СтрСоединить(Игроки, ", ");
	Актуальное.доска = ОбновитьСоставЛоббиДуракаНаСервере(Актуальное.доска, Игроки);
	Актуальное.версия = Актуальное.версия + 1;
	Если Не ЗаписатьСостояниеВФайл(Актуальное) Тогда
		Возврат;
	КонецЕсли;

	РежимИгры = "гость";
	ТипИгры = "дурак";
	ТипИгрыСетевой = "дурак";
	МойЦветБелые = Ложь;
	МойИндексИгрока = Игроки.Количество() - 1;
	РазмерКолоды = ?(Актуальное.размерКолоды = 52, "52", "36");
	ПереводнойДурак = Актуальное.переводной;
	ПрименитьСостояниеНаКлиенте(Актуальное);
	СброситьВыбор();
	ОбновитьБлокировкуТипаИгрыНаСервере();
	ПодключитьОпрос();
	ЗаписатьСвойПульс();
	ПоказатьПредупреждение(, "Вы в лобби (игрок " + Формат(МойИндексИгрока + 1, "ЧГ=0")
		+ "). Ждите, пока хост нажмёт «Начать матч».");

КонецПроцедуры

&НаКлиенте
Процедура НачатьМатч(Команда)

	Если ТипИгры <> "дурак" Или РежимИгры <> "хост" Тогда
		ПоказатьПредупреждение(, "«Начать матч» — только хост в дураке.");
		Возврат;
	КонецЕсли;
	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Или Состояние.статус <> "ожидание" Тогда
		ПоказатьПредупреждение(, "Нет лобби в ожидании.");
		Возврат;
	КонецЕсли;
	Игроки = ИгрокиПартии(Состояние);
	Если Игроки.Количество() < 2 Тогда
		ПоказатьПредупреждение(, "Нужен хотя бы один соперник в лобби.");
		Возврат;
	КонецЕсли;

	Доска = РаздатьДуракаНаСервере(Состояние.доска, Игроки.Количество(), Игроки, Истина);
	Состояние.доска = Доска;
	Состояние.статус = "игра";
	Состояние.ходБелых = ХодБелыхДуракаНаСервере(Доска);
	Состояние.сообщение = "Матч начат, игроков: " + Формат(Игроки.Количество(), "ЧГ=0");
	Состояние.последнийХод = "Раздача";
	Состояние.версия = Состояние.версия + 1;
	Состояние.Вставить("игроки", Игроки);
	Состояние.Вставить("времяСтартаМатча", ТекущаяУниверсальнаяДатаВМиллисекундах());
	Если Не ЗаписатьСостояниеВФайл(Состояние) Тогда
		Возврат;
	КонецЕсли;
	МойИндексИгрока = 0;
	ДуракМатчНачатМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ДуракПульсКэш = "|||";
	ДуракПульсВремя = "0|0|0|0";
	ПрименитьСостояниеНаКлиенте(Состояние);
	ОбновитьОтображение();
	ЗаписатьСвойПульс();
	СброситьЛокальныйТаймерХодаДурака();
	ПодключитьОбработчикОжидания("СброситьАнимациюРаздачиОбработчик", 1.2, Истина);

КонецПроцедуры

&НаКлиенте
Процедура СброситьАнимациюРаздачиОбработчик() Экспорт

	Если ТипИгры <> "дурак" Тогда
		Возврат;
	КонецЕсли;
	Если РежимИгры <> "хост" И РежимИгры <> "гость" Тогда
		Возврат;
	КонецЕсли;
	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДоскаБезАним = СброситьАнимациюРаздачиНаСервере(Состояние.доска);
	Если ДоскаБезАним = Состояние.доска Тогда
		Возврат;
	КонецЕсли;
	Состояние.доска = ДоскаБезАним;
	Состояние.версия = Состояние.версия + 1;
	Если ЗаписатьСостояниеВФайл(Состояние) Тогда
		Доска = ДоскаБезАним;
		ОбновитьОтображение();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ИгрокиПартии(Состояние)

	Если Состояние.Свойство("игроки") И ТипЗнч(Состояние.игроки) = Тип("Массив") И Состояние.игроки.Количество() > 0 Тогда
		Возврат Состояние.игроки;
	КонецЕсли;
	Результат = Новый Массив;
	Если Не ПустаяСтрока(Состояние.имяХоста) Тогда
		Результат.Добавить(Состояние.имяХоста);
	КонецЕсли;
	Если Не ПустаяСтрока(Состояние.имяГостя) Тогда
		Результат.Добавить(Состояние.имяГостя);
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ОбработатьСдачуИлиУходДурака(Причина, ПоказатьДиалог)

	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Состояние.статус = "ожидание" Тогда
		УйтиИзЛоббиДурака(Состояние);
		Возврат;
	КонецЕсли;

	Если Состояние.статус <> "игра" Тогда
		Возврат;
	КонецЕсли;

	Результат = ВывестиИгрокаДуракаНаСервере(Состояние.доска, МойИндексИгрока, Причина);
	Если Не Результат.Ок Тогда
		Возврат;
	КонецЕсли;

	Состояние.доска = Результат.Доска;
	Состояние.статус = Результат.Статус;
	Состояние.сообщение = Результат.Описание;
	Состояние.последнийХод = Результат.Описание;
	Состояние.версия = Состояние.версия + 1;
	Состояние.ходБелых = ХодБелыхДуракаНаСервере(Состояние.доска);
	Если Не ЗаписатьСостояниеВФайл(Состояние) Тогда
		Возврат;
	КонецЕсли;

	ПрименитьСостояниеНаКлиенте(Состояние);
	ОбновитьОтображение();

	Если Результат.Продолжается Тогда
		Если ПоказатьДиалог Тогда
			ПоказатьПредупреждение(, "Вы " + Причина + ". Остальные продолжают игру.");
		КонецЕсли;
	ИначеЕсли ПоказатьДиалог Тогда
		УдалитьСвойПульс();
		ПоказатьОкноПобедыЕслиНужно();
	Иначе
		УдалитьСвойПульс();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УйтиИзЛоббиДурака(Состояние)

	Игроки = ИгрокиПартии(Состояние);
	Новые = Новый Массив;
	Для Каждого ИмяУч Из Игроки Цикл
		Если ВРег(СокрЛП(ИмяУч)) <> ВРег(СокрЛП(ИмяИгрока)) Тогда
			Новые.Добавить(ИмяУч);
		КонецЕсли;
	КонецЦикла;

	УдалитьСвойПульс();
	Если Новые.Количество() = 0 Тогда
		УдалитьФайлыПартииПоКоду();
		УдалитьФайлыПульсовПартии();
	Иначе
		Состояние.Вставить("игроки", Новые);
		Состояние.имяХоста = Новые[0];
		Состояние.имяГостя = ?(Новые.Количество() > 1, Новые[1], "");
		Состояние.доска = ОбновитьСоставЛоббиДуракаНаСервере(
			НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак), Новые);
		Состояние.статус = "ожидание";
		Состояние.сообщение = ИмяИгрока + " вышел из лобби";
		Состояние.последнийХод = Состояние.сообщение;
		Состояние.версия = Состояние.версия + 1;
		ЗаписатьСостояниеВФайл(Состояние);
	КонецЕсли;

	РежимИгры = "";
	ТипИгрыСетевой = "";
	СтатусПартии = "";
	ОтключитьОбработчикОжидания("ОпросПартииОбработчик");
	ОбновитьБлокировкуТипаИгрыНаСервере();
	Доска = НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак);
	ОбновитьОтображение();
	ТекстСтатуса = "Вы вышли из лобби.";

КонецПроцедуры

&НаКлиенте
Процедура СообщитьОбУходеИзСети(Причина)

	Если ТипИгры <> "дурак" Тогда
		Возврат;
	КонецЕсли;
	Если РежимИгры <> "хост" И РежимИгры <> "гость" Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПутьКПапке) Или ПустаяСтрока(КодПартии) Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ОбработатьСдачуИлиУходДурака(Причина, Ложь);
	Исключение
		// Игнорируем ошибки при закрытии.
	КонецПопытки;
	УдалитьСвойПульс();

КонецПроцедуры

&НаКлиенте
Функция ОбработатьПропавшихИгроковДурака(Состояние)

	Если Состояние.статус <> "игра" Тогда
		Возврат Ложь;
	КонецЕсли;

	// Только хост исключает игроков — меньше гонок по файлу.
	Если РежимИгры <> "хост" Тогда
		Возврат Ложь;
	КонецЕсли;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ДуракМатчНачатМс <= 0 Тогда
		ДуракМатчНачатМс = Сейчас;
	КонецЕсли;
	// Долгая пауза после старта: общая папка может отдавать hb с задержкой.
	Если (Сейчас - ДуракМатчНачатМс) < 60000 Тогда
		Возврат Ложь;
	КонецЕсли;

	Игроки = ИгрокиПартии(Состояние);
	ТаймаутМс = 45000;
	Изменено = Ложь;

	Для Индекс = 0 По Игроки.Количество() - 1 Цикл
		Если Индекс = МойИндексИгрока Тогда
			Продолжить;
		КонецЕсли;
		Если ПульсИгрокаСвежий(Индекс, ТаймаутМс) Тогда
			Продолжить;
		КонецЕсли;
		Если ИгрокУжеВнеМатчаДуракаНаСервере(Состояние.доска, Индекс) Тогда
			Продолжить;
		КонецЕсли;
		Результат = ВывестиИгрокаДуракаНаСервере(Состояние.доска, Индекс, "отключился (закрыл обработку или 1С)");
		Если Не Результат.Ок Тогда
			Продолжить;
		КонецЕсли;
		Состояние.доска = Результат.Доска;
		Состояние.статус = Результат.Статус;
		Состояние.сообщение = Результат.Описание;
		Состояние.последнийХод = Результат.Описание;
		Состояние.версия = Состояние.версия + 1;
		Состояние.ходБелых = ХодБелыхДуракаНаСервере(Состояние.доска);
		Если ЗаписатьСостояниеВФайл(Состояние) Тогда
			Изменено = Истина;
		КонецЕсли;
		Прервать;
	КонецЦикла;

	Возврат Изменено;

КонецФункции

&НаКлиенте
Процедура ВернутьСетевойДуракВЛобби()

	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Доска = НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак);
		СтатусПартии = "ожидание";
		ОбновитьОтображение();
		Возврат;
	КонецЕсли;

	ИгрокиБыло = ИгрокиПартии(Состояние);
	Живые = Новый Массив;
	Для Индекс = 0 По ИгрокиБыло.Количество() - 1 Цикл
		Если Индекс = МойИндексИгрока Или ПульсИгрокаСвежий(Индекс, 15000) Тогда
			Живые.Добавить(ИгрокиБыло[Индекс]);
		КонецЕсли;
	КонецЦикла;
	Если Живые.Количество() = 0 Тогда
		Живые.Добавить(ИмяИгрока);
	КонецЕсли;

	// Хост (или единственный онлайн) перезаписывает лобби.
	МожноПисать = (РежимИгры = "хост") Или (МойИндексИгрока = 0);
	Если Не МожноПисать Тогда
		// Гость ждёт запись хоста; если хоста нет — пишем сами.
		Если Не ПульсИгрокаСвежий(0, 15000) Тогда
			МожноПисать = Истина;
		КонецЕсли;
	КонецЕсли;

	Если МожноПисать Тогда
		Размер = ?(Состояние.Свойство("размерКолоды") И Состояние.размерКолоды = 52, 52, 36);
		Перевод = ?(Состояние.Свойство("переводной"), Состояние.переводной, Ложь);
		ДоскаЛобби = НовоеЛоббиДуракаНаСервере(Размер, Перевод);
		ДоскаЛобби = ОбновитьСоставЛоббиДуракаНаСервере(ДоскаЛобби, Живые);
		Состояние.доска = ДоскаЛобби;
		Состояние.статус = "ожидание";
		Состояние.Вставить("игроки", Живые);
		Состояние.имяХоста = Живые[0];
		Состояние.имяГостя = ?(Живые.Количество() > 1, Живые[1], "");
		Состояние.сообщение = "Матч окончен. Снова лобби.";
		Состояние.последнийХод = ТекстСоставаЛобби(Живые);
		Состояние.версия = Состояние.версия + 1;
		Состояние.Вставить("времяСтартаМатча", 0);
		ЗаписатьСостояниеВФайл(Состояние);
	КонецЕсли;

	Индекс = 0;
	Для Каждого ИмяУч Из Живые Цикл
		Если ВРег(СокрЛП(ИмяУч)) = ВРег(СокрЛП(ИмяИгрока)) Тогда
			МойИндексИгрока = Индекс;
			Прервать;
		КонецЕсли;
		Индекс = Индекс + 1;
	КонецЦикла;
	РежимИгры = ?(МойИндексИгрока = 0, "хост", "гость");
	МойЦветБелые = (МойИндексИгрока = 0);
	ПрименитьСостояниеНаКлиенте(?(Состояние = Неопределено, ПрочитатьСостояниеИзФайла(), Состояние));
	ЗаписатьСвойПульс();
	ПодключитьОпрос();
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Функция ПутьФайлаПульса(ИндексИгрока)

	Каталог = ПутьКПапке;
	Если Прав(Каталог, 1) <> "\" И Прав(Каталог, 1) <> "/" Тогда
		Каталог = Каталог + "\";
	КонецЕсли;
	БезопасныйКод = КодПартии;
	Возврат Каталог + "durak_" + БезопасныйКод + "_hb_" + Формат(ИндексИгрока, "ЧН=0; ЧГ=0") + ".txt";

КонецФункции

&НаКлиенте
Процедура ЗаписатьСвойПульс()

	Если ТипИгры <> "дурак" Тогда
		Возврат;
	КонецЕсли;
	Если РежимИгры <> "хост" И РежимИгры <> "гость" Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ПутьКПапке) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		// Счётчик без абсолютного времени — чтобы часы ПК не влияли на «свежесть».
		Счётчик = Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ=0");
		Запись = Новый ЗаписьТекста(ПутьФайлаПульса(МойИндексИгрока), КодировкаТекста.UTF8);
		Запись.Записать(Формат(МойИндексИгрока, "ЧН=0; ЧГ=0") + ":" + Счётчик);
		Запись.Закрыть();
	Исключение
		// Нет доступа к папке — остальные обнаружат по таймауту.
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура УдалитьСвойПульс()

	Если ПустаяСтрока(ПутьКПапке) Тогда
		Возврат;
	КонецЕсли;
	УдалитьФайлЕслиЕсть(ПутьФайлаПульса(МойИндексИгрока));

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлыПульсовПартии()

	Если ПустаяСтрока(ПутьКПапке) Тогда
		Возврат;
	КонецЕсли;
	Для Индекс = 0 По 3 Цикл
		УдалитьФайлЕслиЕсть(ПутьФайлаПульса(Индекс));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция ПульсИгрокаСвежий(ИндексИгрока, ТаймаутМс)

	// Свежесть = «содержимое hb менялось недавно по МОИМ часам».
	// Не сравниваем метки времени разных ПК (из‑за этого были ложные отключения).
	Путь = ПутьФайлаПульса(ИндексИгрока);
	Текст = "";
	Попытка
		Файл = Новый Файл(Путь);
		Если Файл.Существует() Тогда
			Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
			Текст = СокрЛП(Чтение.Прочитать());
			Чтение.Закрыть();
		КонецЕсли;
	Исключение
		Текст = "";
	КонецПопытки;

	Кэш = СтрРазделить(?(ПустаяСтрока(ДуракПульсКэш), "|||", ДуракПульсКэш), "|");
	Времена = СтрРазделить(?(ПустаяСтрока(ДуракПульсВремя), "0|0|0|0", ДуракПульсВремя), "|");
	Пока Кэш.Количество() < 4 Цикл
		Кэш.Добавить("");
	КонецЦикла;
	Пока Времена.Количество() < 4 Цикл
		Времена.Добавить("0");
	КонецЦикла;

	Сейчас = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если Текст <> Кэш[ИндексИгрока] Тогда
		Кэш[ИндексИгрока] = Текст;
		Времена[ИндексИгрока] = Формат(Сейчас, "ЧГ=0");
		ДуракПульсКэш = СтрСоединить(Кэш, "|");
		ДуракПульсВремя = СтрСоединить(Времена, "|");
		Возврат Истина;
	КонецЕсли;

	Если ПустаяСтрока(Текст) Тогда
		// Файла ещё нет — в льготный период после старта считаем онлайн.
		Если ДуракМатчНачатМс > 0 И (Сейчас - ДуракМатчНачатМс) < 90000 Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Было = Число(Времена[ИндексИгрока]);
	Исключение
		Было = 0;
	КонецПопытки;
	Если Было <= 0 Тогда
		Времена[ИндексИгрока] = Формат(Сейчас, "ЧГ=0");
		ДуракПульсВремя = СтрСоединить(Времена, "|");
		Возврат Истина;
	КонецЕсли;

	Возврат (Сейчас - Было) <= ТаймаутМс;

КонецФункции

&НаКлиенте
Функция НайтиПартиюДляПодключения()

	Результат = Новый Структура("Состояние, ТипИгры, Проблема", Неопределено, ТипИгры, "");
	ТекстМаксимум = "В этой партии уже максимальное количество игроков. Подключение невозможно.";
	ТипыПоиска = Новый Массив;
	ТипыПоиска.Добавить(ТипИгры);
	Для Каждого Кандидат Из СтрРазделить("шашки,шахматы,дурак", ",") Цикл
		Если Кандидат <> ТипИгры И Кандидат <> "пасьянс" Тогда
			ТипыПоиска.Добавить(Кандидат);
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТипФайла Из ТипыПоиска Цикл
		Своя = ПрочитатьСостояниеПоТипу(ТипФайла);
		Если Своя = Неопределено Или Своя.статус <> "ожидание" Тогда
			Продолжить;
		КонецЕсли;
		Если ТипФайла = "дурак" Тогда
			Игроки = ИгрокиПартии(Своя);
			МаксИгр = ?(Своя.Свойство("максИгроков"), Своя.максИгроков, 4);
			Если Игроки.Количество() < МаксИгр Тогда
				Результат.Состояние = Своя;
				Результат.ТипИгры = ТипФайла;
				Возврат Результат;
			КонецЕсли;
		ИначеЕсли ПустаяСтрока(Своя.имяГостя) Тогда
			Результат.Состояние = Своя;
			Результат.ТипИгры = ТипФайла;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Для Каждого ТипФайла Из ТипыПоиска Цикл
		Своя = ПрочитатьСостояниеПоТипу(ТипФайла);
		Если ПартияУжеЗаполнена(Своя) Тогда
			Результат.Проблема = ТекстМаксимум;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	Своя = ПрочитатьСостояниеПоТипу(ТипИгры);
	Если Своя <> Неопределено Тогда
		Результат.Проблема = "Файл партии «" + ТипИгры + "» есть, но она не ждёт гостя (статус: " + Своя.статус + ").";
		Возврат Результат;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПартияУжеЗаполнена(Состояние)

	Если Состояние = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Состояние.Свойство("типИгры") И НРег(Состояние.типИгры) = "дурак" Тогда
		Игроки = ИгрокиПартии(Состояние);
		МаксИгр = ?(Состояние.Свойство("максИгроков"), Состояние.максИгроков, 4);
		Если Состояние.статус = "ожидание" И Игроки.Количество() >= МаксИгр Тогда
			Возврат Истина;
		КонецЕсли;
		Если Состояние.статус = "игра" Или Состояние.статус = "победаБелых"
			Или Состояние.статус = "победаЧерных" Или Состояние.статус = "ничья" Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	Если Не ПустаяСтрока(Состояние.имяГостя) Тогда
		Возврат Истина;
	КонецЕсли;
	Если Состояние.статус = "игра"
		Или Состояние.статус = "победаБелых"
		Или Состояние.статус = "победаЧерных"
		Или Состояние.статус = "ничья" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаКлиенте
Функция ПрочитатьСостояниеПоТипу(ТипИгрыФайла)

	ПутьФайла = ПутьФайлаПартииПоТипу(ТипИгрыФайла);
	Если Не ФайлСуществуетКлиент(ПутьФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат JSONВСостояниеНаСервере(Текст);


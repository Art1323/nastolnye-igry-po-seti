&НаКлиенте
Функция ПрочитатьСостояниеИзФайла()

	ПутьФайла = ПутьФайлаПартии();
	Если Не ФайлСуществуетКлиент(ПутьФайла) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеТекста(ПутьФайла, КодировкаТекста.UTF8);
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат JSONВСостояниеНаСервере(Текст);


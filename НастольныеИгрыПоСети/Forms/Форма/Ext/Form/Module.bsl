&НаСервере
Процедура ОбновитьДоскуНаСервере()

	Если ТипИгры = "пасьянс" Тогда
		ДоскаHTML = Логика().СформироватьHTMLПасьянса(Доска, ВыборПасьянса);
		Возврат;
	КонецЕсли;

	Если ТипИгры = "дурак" Тогда
		ЯИгрок0 = (МойИндексИгрока = 0);
		РежимПросмотра = "";
		Индекс = МойИндексИгрока;
		Если РежимИгры = "локально" Тогда
			ЯИгрок0 = ХодБелых;
			Индекс = ?(ХодБелых, 0, 1);
		ИначеЕсли РежимИгры = "бот" Тогда
			РежимПросмотра = "бот";
			Индекс = 0;
		КонецЕсли;
		ДоскаHTML = Логика().СформироватьHTMLДурака(Доска, ЯИгрок0, РежимПросмотра, Индекс);
		Возврат;
	КонецЕсли;

	Подсветка = Новый Массив;
	Если ВыбранаСтрока >= 0 И (СтатусПартии = "игра" Или РежимИгры = "локально") Тогда
		Если ТипИгры = "шахматы" Тогда
			Подсветка = Логика().ПолучитьХодыШахмат(Доска, ХодБелых, ВыбранаСтрока, ВыбранаКолонка, РокировкаПрава, ПолеEP);
		Иначе
			Подсветка = Логика().ПолучитьХоды(Доска, ХодБелых, ВыбранаСтрока, ВыбранаКолонка, ВзятыеКлетки, ЦепочкаВзятия, ОбязательноеВзятие);
		КонецЕсли;
	КонецЕсли;

	Перевёрнута = Ложь;
	Если РежимИгры = "гость" Тогда
		Перевёрнута = Истина;
	ИначеЕсли РежимИгры = "локально" Тогда
		Перевёрнута = Не ХодБелых;
	КонецЕсли;

	Если ТипИгры = "шахматы" Тогда
		ДоскаHTML = Логика().СформироватьHTMLДоскиШахмат(Доска, ВыбранаСтрока, ВыбранаКолонка, Подсветка, Перевёрнута);
	Иначе
		ДоскаHTML = Логика().СформироватьHTMLДоски(Доска, ВыбранаСтрока, ВыбранаКолонка, Подсветка, Перевёрнута, ОбязательноеВзятие);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьНастроекНаСервере()

	ЭтоДурак = (ТипИгры = "дурак");
	Элементы.ОбязательноеВзятие.Видимость = (ТипИгры = "шашки");
	Элементы.РазмерКолоды.Видимость = ЭтоДурак;
	Элементы.ПереводнойДурак.Видимость = ЭтоДурак;
	Элементы.ФормаХодНазад.Видимость = (РежимИгры = "пасьянс" Или ТипИгры = "пасьянс");
	Элементы.ФормаНачатьМатч.Видимость = (ТипИгры = "дурак" И РежимИгры = "хост" И СтатусПартии = "ожидание");
	Элементы.ГруппаХодВручную.Видимость = (ТипИгры <> "пасьянс" И ТипИгры <> "дурак");
	ОбновитьБлокировкуТипаИгрыНаСервере();


	Попытка
		Запись = Новый ЗаписьТекста(ПутьФайла, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
		Возврат Истина;
	Исключение
		ПоказатьПредупреждение(, "Не удалось записать файл партии: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПрименитьСостояниеНаКлиенте(Состояние)

	Доска = Состояние.доска;
	ХодБелых = Состояние.ходБелых;
	СтатусПартии = Состояние.статус;
	ВерсияПартии = Состояние.версия;
	ПоследнийХод = Состояние.последнийХод;
	ИмяХоста = Состояние.имяХоста;
	ИмяГостя = Состояние.имяГостя;
	Если Состояние.Свойство("типИгры") Тогда
		ТипИгры = Состояние.типИгры;
		Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
			ТипИгрыСетевой = ТипИгры;
		КонецЕсли;
	КонецЕсли;
	Если Состояние.Свойство("обязательноеВзятие") Тогда
		ОбязательноеВзятие = Состояние.обязательноеВзятие;
	КонецЕсли;
	Если Состояние.Свойство("рокировка") Тогда
		РокировкаПрава = Состояние.рокировка;
	КонецЕсли;
	Если Состояние.Свойство("полеEP") Тогда
		ПолеEP = Состояние.полеEP;
	КонецЕсли;
	Если Состояние.Свойство("размерКолоды") И Состояние.размерКолоды > 0 Тогда
		РазмерКолоды = Формат(Состояние.размерКолоды, "ЧГ=0");
	КонецЕсли;
	Если Состояние.Свойство("переводной") Тогда
		ПереводнойДурак = Состояние.переводной;
	КонецЕсли;
	Если ТипИгры = "дурак" Тогда
		ХодБелых = ХодБелыхДуракаНаСервере(Доска);
		Если Состояние.Свойство("игроки") Тогда
			Индекс = 0;
			Для Каждого ИмяУч Из ИгрокиПартии(Состояние) Цикл
				Если ВРег(СокрЛП(ИмяУч)) = ВРег(СокрЛП(ИмяИгрока)) Тогда
					МойИндексИгрока = Индекс;
					Прервать;
				КонецЕсли;
				Индекс = Индекс + 1;
			КонецЦикла;
			Если Состояние.статус = "ожидание" Тогда
				ИгрокиЛобби = ИгрокиПартии(Состояние);
				ПоследнийХод = ТекстСоставаЛобби(ИгрокиЛобби);
				// Подтягиваем имена с партии на доску (чтобы HTML совпадал со статусом).
				Доска = ОбновитьСоставЛоббиДуракаНаСервере(Доска, ИгрокиЛобби);
			КонецЕсли;
		КонецЕсли;
		Если Состояние.статус = "игра" Тогда
			Если ДуракМатчНачатМс <= 0 Тогда
				ДуракМатчНачатМс = ТекущаяУниверсальнаяДатаВМиллисекундах();
				ДуракПульсКэш = "|||";
				ДуракПульсВремя = "0|0|0|0";
			КонецЕсли;
			ОбновитьЛокальныйТаймерХодаДурака();
			ЗаписатьСвойПульс();
		Иначе
			ДуракМатчНачатМс = 0;
		КонецЕсли;
	КонецЕсли;
	ОбновитьВидимостьНастроекНаСервере();
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Функция ТекстСоставаЛобби(Игроки)

	Если Игроки.Количество() = 0 Тогда
		Возврат "В лобби пока никого";
	КонецЕсли;
	Части = Новый Массив;
	Для Индекс = 0 По Игроки.Количество() - 1 Цикл
		Роль = ?(Индекс = 0, "хост", "игрок " + Формат(Индекс + 1, "ЧГ=0"));
		Части.Добавить(Роль + " «" + Игроки[Индекс] + "»");
	КонецЦикла;
	Возврат "Подключились (" + Формат(Игроки.Количество(), "ЧГ=0") + "/4): " + СтрСоединить(Части, "; ");

КонецФункции

&НаКлиенте
Процедура ОбновитьОтображение()

	ОбновитьДоскуНаСервере();
	ТекстСтатуса = СобратьТекстСтатуса();
	Если СтатусПартии = "ожидание" И ТипИгры = "дурак" Тогда
		ТекстХода = ?(ПустаяСтрока(ПоследнийХод), "Лобби: ожидание игроков", ПоследнийХод);
	ИначеЕсли СтатусПартии = "победаБелых" Тогда
		Если ТипИгры = "пасьянс" Тогда
			ТекстХода = "Пасьянс собран!";
		ИначеЕсли ТипИгры = "дурак" Тогда
			ТекстХода = ?(РежимИгры = "бот", "Вы победили!", "Победа игрока 1!");
		ИначеЕсли ТипИгры = "шахматы" Тогда
			ТекстХода = "Мат! Победа белых!";
		Иначе
			ТекстХода = "Победа белых!";
		КонецЕсли;
		ТекстХода = ТекстХода + ?(ПустаяСтрока(ПоследнийХод), "", " Последний: " + ПоследнийХод);
	ИначеЕсли СтатусПартии = "победаЧерных" Тогда
		Если ТипИгры = "дурак" Тогда
			ТекстХода = ?(РежимИгры = "бот", "Победил бот!", "Победа игрока 2!");
		ИначеЕсли ТипИгры = "шахматы" Тогда
			ТекстХода = "Мат! Победа чёрных!";
		Иначе
			ТекстХода = "Победа чёрных!";
		КонецЕсли;
		ТекстХода = ТекстХода + ?(ПустаяСтрока(ПоследнийХод), "", " Последний: " + ПоследнийХод);
	ИначеЕсли СтатусПартии = "ничья" Тогда
		ТекстХода = "Ничья!" + ?(ПустаяСтрока(ПоследнийХод), "", " Последний: " + ПоследнийХод);
	ИначеЕсли ТипИгры = "пасьянс" Тогда
		Если Не ПустаяСтрока(ВыборПасьянса) Тогда
			ТекстХода = "Карта выбрана (жёлтая). Кликните зелёную цель: дом или стол";
		Иначе
			ТекстХода = "Сток → карта. Затем карта и цель (дом/стол)"
				+ ?(ПустаяСтрока(ПоследнийХод), "", ". " + ПоследнийХод);
		КонецЕсли;
	ИначеЕсли ТипИгры = "дурак" Тогда
		ОбновитьЛокальныйТаймерХодаДурака();
		Сек = СекундЛокальногоТаймераДурака();
		Лимит = ЛимитСекундХодаДуракаНаСервере();
		ТекстХода = ?(ПустаяСтрока(ПоследнийХод),
			?(ХодБелых, "Ход игрока 1", "Ход игрока 2"),
			ПоследнийХод)
			+ " · таймер " + Формат(Сек, "ЧН=0; ЧГ=0") + "/" + Формат(Лимит, "ЧГ=0") + " с";
	ИначеЕсли ХодБелых Тогда
		ТекстХода = "Ход белых" + ?(ПустаяСтрока(ПоследнийХод), "", ". Последний: " + ПоследнийХод);
	Иначе
		ТекстХода = "Ход чёрных" + ?(ПустаяСтрока(ПоследнийХод), "", ". Последний: " + ПоследнийХод);
	КонецЕсли;

	ПодключитьТаймерОтображенияХодаДурака();

КонецПроцедуры

&НаКлиенте
Функция СобратьТекстСтатуса()

	ИмяРежима = ?(ТипИгры = "шахматы", "Шахматы",
		?(ТипИгры = "пасьянс", "Пасьянс",
		?(ТипИгры = "дурак", "Дурак", "Шашки")));
	Если РежимИгры = "локально" Тогда
		База = ИмяРежима + ": локальная партия";
	ИначеЕсли РежимИгры = "пасьянс" Тогда
		База = "Пасьянс «Косынка»: одиночная игра";
	ИначеЕсли РежимИгры = "бот" Тогда
		Если ТипИгры = "дурак" Тогда
			База = "Дурак: вы (игрок 1) против бота";
		Иначе
			База = ИмяРежима + ": вы (белые) против бота (средняя сложность)";
		КонецЕсли;
	ИначеЕсли РежимИгры = "хост" Тогда
		Если ТипИгры = "дурак" Тогда
			База = "Дурак: хост · лобби/матч (до 4). Вы — игрок "
				+ Формат(МойИндексИгрока + 1, "ЧГ=0");
		Иначе
			База = ИмяРежима + ": хост (белые): " + ИмяХоста + " / гость: "
				+ ?(ПустаяСтрока(ИмяГостя), "ожидание", ИмяГостя);
		КонецЕсли;
	ИначеЕсли РежимИгры = "гость" Тогда
		Если ТипИгры = "дурак" Тогда
			База = "Дурак: гость · вы игрок " + Формат(МойИндексИгрока + 1, "ЧГ=0");
		Иначе
			База = ИмяРежима + ": гость (чёрные): " + ИмяГостя + " / хост: " + ИмяХоста;
		КонецЕсли;
	Иначе
		База = ИмяРежима + ": нет активной партии";
	КонецЕсли;

	Если СтатусПартии = "ожидание" Тогда
		Если ТипИгры = "дурак" Тогда
			Возврат База + " — лобби. " + ?(ПустаяСтрока(ПоследнийХод), "Ждём игроков", ПоследнийХод);
		КонецЕсли;
		Возврат База + " — ожидание соперника";
	ИначеЕсли СтатусПартии = "победаБелых" Тогда
		Если ТипИгры = "дурак" И РежимИгры = "бот" Тогда
			Возврат База + " — вы победили";
		КонецЕсли;
		Возврат База + " — победа белых";
	ИначеЕсли СтатусПартии = "победаЧерных" Тогда
		Если ТипИгры = "дурак" И РежимИгры = "бот" Тогда
			Возврат База + " — победил бот";
		КонецЕсли;
		Возврат База + " — победа чёрных";
	ИначеЕсли СтатусПартии = "ничья" Тогда
		Возврат База + " — ничья";
	ИначеЕсли СтатусПартии = "игра" Тогда
		Возврат База + " — игра";
	КонецЕсли;
	Возврат База;

КонецФункции

&НаКлиенте
Функция РазмерКолодыЧислом()

	Если СокрЛП(РазмерКолоды) = "52" Тогда
		Возврат 52;
	КонецЕсли;
	Возврат 36;

КонецФункции

&НаКлиенте
Функция СейчасМойХод()

	Если СтатусПартии <> "игра" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если РежимИгры = "пасьянс" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипИгры = "дурак" Тогда
		Если РежимИгры = "локально" Тогда
			Возврат Истина;
		КонецЕсли;
		Если РежимИгры = "бот" Тогда
			Возврат ХодБелых;
		КонецЕсли;
		Возврат ИндексХодаДуракаНаСервере(Доска) = МойИндексИгрока;
	КонецЕсли;
	Если РежимИгры = "бот" Тогда
		Возврат ХодБелых; // игрок всегда белые
	КонецЕсли;
	Если РежимИгры = "локально" Тогда
		Возврат Истина;
	КонецЕсли;
	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		Возврат ХодБелых = МойЦветБелые;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура СброситьВыбор()

	Если Не ЦепочкаВзятия Тогда
		ВыбранаСтрока = -1;
		ВыбранаКолонка = -1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКликПоКлетке(СтрокаКлетки, КолонкаКлетки)

	Если ТипИгры = "пасьянс" Тогда
		ОбработатьКликПасьянсаПоКоординатам(СтрокаКлетки, КолонкаКлетки);
		Возврат;
	КонецЕсли;

	Если ТипИгры = "дурак" Тогда
		ОбработатьКликДуракаПоКоординатам(СтрокаКлетки, КолонкаКлетки);
		Возврат;
	КонецЕсли;

	Если Не СейчасМойХод() Тогда
		Возврат;
	КонецЕсли;

	Если ТипИгры = "шахматы" Тогда
		ОбработатьКликШахматы(СтрокаКлетки, КолонкаКлетки);
		Возврат;
	КонецЕсли;

	ХодыСВыбранной = Неопределено;
	Если ВыбранаСтрока >= 0 Тогда
		ХодыСВыбранной = ПолучитьХодыНаСервере(Доска, ХодБелых, ВыбранаСтрока, ВыбранаКолонка, ВзятыеКлетки, ЦепочкаВзятия, ОбязательноеВзятие);
		Для Каждого Ход Из ХодыСВыбранной Цикл
			Если Ход.ВСтрока = СтрокаКлетки И Ход.ВКолонка = КолонкаКлетки Тогда
				ВыполнитьХодНаКлиенте(Ход);
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Если ЦепочкаВзятия Тогда
			Если ОбязательноеВзятие Тогда
				Возврат;
			КонецЕсли;
			ЗавершитьХодПослеВзятия();
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Символ = СимволКлеткиНаСервере(Доска, СтрокаКлетки, КолонкаКлетки);
	Цвет = ЦветФигурыНаСервере(Символ);
	НужныйЦвет = ?(ХодБелых, "б", "ч");
	Если Цвет <> НужныйЦвет Тогда
		Если Не ЦепочкаВзятия Тогда
			ВыбранаСтрока = -1;
			ВыбранаКолонка = -1;
			ОбновитьОтображение();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	ВыбранаСтрока = СтрокаКлетки;
	ВыбранаКолонка = КолонкаКлетки;
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКликШахматы(СтрокаКлетки, КолонкаКлетки)

	Если ВыбранаСтрока >= 0 Тогда
		ХодыСВыбранной = ПолучитьХодыШахматНаСервере(Доска, ХодБелых, ВыбранаСтрока, ВыбранаКолонка, РокировкаПрава, ПолеEP);
		Для Каждого Ход Из ХодыСВыбранной Цикл
			Если Ход.ВСтрока = СтрокаКлетки И Ход.ВКолонка = КолонкаКлетки Тогда
				ВыполнитьХодШахматНаКлиенте(Ход);
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Символ = СимволКлеткиНаСервере(Доска, СтрокаКлетки, КолонкаКлетки);
	Цвет = ЦветШахматнойФигурыНаСервере(Символ);
	НужныйЦвет = ?(ХодБелых, "б", "ч");
	Если Цвет <> НужныйЦвет Тогда
		ВыбранаСтрока = -1;
		ВыбранаКолонка = -1;
		ОбновитьОтображение();
		Возврат;
	КонецЕсли;

	ВыбранаСтрока = СтрокаКлетки;
	ВыбранаКолонка = КолонкаКлетки;
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьХодШахматНаКлиенте(Ход)

	Доска = Ход.ДоскаПосле;
	ПоследнийХод = ?(ПустаяСтрока(ПоследнийХод), "", ПоследнийХод + " ") + Ход.Описание;
	Если Ход.Свойство("РокировкаПосле") Тогда
		РокировкаПрава = Ход.РокировкаПосле;
	КонецЕсли;
	Если Ход.Свойство("ПолеEPПосле") Тогда
		ПолеEP = Ход.ПолеEPПосле;
	Иначе
		ПолеEP = "";
	КонецЕсли;
	ВыбранаСтрока = -1;
	ВыбранаКолонка = -1;
	ХодБелых = Не ХодБелых;
	СтатусПартии = ОпределитьСтатусШахматНаСервере(Доска, ХодБелых, РокировкаПрава, ПолеEP);

	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		СохранитьПартиюПослеХода();
	КонецЕсли;

	ОбновитьОтображение();
	ПоказатьОкноПобедыЕслиНужно();
	ЗапланироватьХодБотаЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьХодПослеВзятия()

	ЦепочкаВзятия = Ложь;
	ВзятыеКлетки = "|";
	ВыбранаСтрока = -1;
	ВыбранаКолонка = -1;
	ХодБелых = Не ХодБелых;
	СтатусПартии = ОпределитьСтатусПослеХодаНаСервере(Доска, ХодБелых, ОбязательноеВзятие);

	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		СохранитьПартиюПослеХода();
	КонецЕсли;

	ОбновитьОтображение();
	ПоказатьОкноПобедыЕслиНужно();
	ЗапланироватьХодБотаЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьХодНаКлиенте(Ход)

	Доска = Ход.ДоскаПосле;
	ПоследнийХод = ?(ПустаяСтрока(ПоследнийХод), "", ПоследнийХод + " ") + Ход.Описание;

	Если Ход.ЕстьВзятие Тогда
		Ключ = Формат(Ход.ВзятиеСтрока, "ЧН=0; ЧГ=0") + "x" + Формат(Ход.ВзятиеКолонка, "ЧН=0; ЧГ=0");
		ВзятыеКлетки = ВзятыеКлетки + Ключ + "|";
		Если Не ЕстьФигурыЦветаНаСервере(Доска, ?(ХодБелых, "ч", "б")) Тогда
			ЦепочкаВзятия = Ложь;
			ВзятыеКлетки = "|";
			ВыбранаСтрока = -1;
			ВыбранаКолонка = -1;
			СтатусПартии = ?(ХодБелых, "победаБелых", "победаЧерных");
			Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
				СохранитьПартиюПослеХода();
			КонецЕсли;
			ОбновитьОтображение();
			ПоказатьОкноПобедыЕслиНужно();
			Возврат;
		КонецЕсли;
		Если НужноПродолжитьВзятиеНаСервере(Доска, ХодБелых, Ход.ВСтрока, Ход.ВКолонка, ВзятыеКлетки) Тогда
			ЦепочкаВзятия = Истина;
			ВыбранаСтрока = Ход.ВСтрока;
			ВыбранаКолонка = Ход.ВКолонка;
			ОбновитьОтображение();
			ЗапланироватьХодБотаЕслиНужно();
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЦепочкаВзятия = Ложь;
	ВзятыеКлетки = "|";
	ВыбранаСтрока = -1;
	ВыбранаКолонка = -1;
	ХодБелых = Не ХодБелых;
	СтатусПартии = ОпределитьСтатусПослеХодаНаСервере(Доска, ХодБелых, ОбязательноеВзятие);

	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		СохранитьПартиюПослеХода();
	КонецЕсли;

	ОбновитьОтображение();
	ПоказатьОкноПобедыЕслиНужно();
	ЗапланироватьХодБотаЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ЗапланироватьХодБотаЕслиНужно()

	Если РежимИгры <> "бот" Или СтатусПартии <> "игра" Тогда
		Возврат;
	КонецЕсли;
	// Бот — чёрные; пока ход белых (в т.ч. цепочка игрока) — не ходим.
	Если ХодБелых Тогда
		Возврат;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ХодБотаОбработчик", 0.45, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ХодБотаОбработчик() Экспорт

	Если РежимИгры <> "бот" Или СтатусПартии <> "игра" Или ХодБелых Тогда
		Возврат;
	КонецЕсли;

	Если ТипИгры = "шахматы" Тогда
		Ход = ВыбратьХодБотаШахматНаСервере(Доска, ХодБелых, РокировкаПрава, ПолеEP);
		Если Ход = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ВыполнитьХодШахматНаКлиенте(Ход);
	ИначеЕсли ТипИгры = "дурак" Тогда
		Результат = ХодБотаДуракаНаСервере(Доска, Истина);
		Если Не Результат.Ок Тогда
			Возврат;
		КонецЕсли;
		Доска = Результат.Доска;
		СтатусПартии = Результат.Статус;
		ПоследнийХод = Результат.Описание;
		ХодБелых = ХодБелыхДуракаНаСервере(Доска);
		ОбновитьОтображение();
		ПоказатьОкноПобедыЕслиНужно();
		ЗапланироватьХодБотаЕслиНужно();
	Иначе
		Ход = ВыбратьХодБотаШашкиНаСервере(Доска, ХодБелых, ВзятыеКлетки, ЦепочкаВзятия,
			ОбязательноеВзятие, ВыбранаСтрока, ВыбранаКолонка);
		Если Ход = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ВыполнитьХодНаКлиенте(Ход);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОкноПобедыЕслиНужно()

	Если СтатусПартии <> "победаБелых" И СтатусПартии <> "победаЧерных" И СтатусПартии <> "ничья" Тогда
		Возврат;
	КонецЕсли;

	Текст = ТекстПобедыНаСервере(СтатусПартии, ТипИгры, РежимИгры);
	Если ТипИгры = "дурак" И Не ПустаяСтрока(ПоследнийХод) Тогда
		Текст = Текст + Символы.ПС + ПоследнийХод;
	КонецЕсли;
	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		Если ТипИгры = "дурак" Тогда
			Текст = Текст + Символы.ПС + "Вернуться в лобби?";
		Иначе
			Текст = Текст + Символы.ПС + "Файл партии будет удалён из общей папки.";
			Текст = Текст + Символы.ПС + "Начать новую партию?";
		КонецЕсли;
	Иначе
		Текст = Текст + Символы.ПС + "Начать новую партию?";
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОНовойПартии", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, Текст, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Игра окончена");

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОНовойПартии(Результат, ДополнительныеПараметры) Экспорт

	Если ТипИгры = "дурак" И (РежимИгры = "хост" Или РежимИгры = "гость") Тогда
		Если Результат = КодВозвратаДиалога.Да Тогда
			ВернутьСетевойДуракВЛобби();
		Иначе
			УдалитьФайлыПартииПоКоду();
			УдалитьФайлыПульсовПартии();
			РежимИгры = "";
			ТипИгрыСетевой = "";
			СтатусПартии = "";
			ОтключитьОбработчикОжидания("ОпросПартииОбработчик");
			ОбновитьБлокировкуТипаИгрыНаСервере();
			Доска = НовоеЛоббиДуракаНаСервере(РазмерКолодыЧислом(), ПереводнойДурак);
			ОбновитьОтображение();
			ТекстСтатуса = "Партия завершена. Можно создать новую.";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	// После окончания партии убираем файлы, чтобы не мешали следующему подключению.
	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		УдалитьФайлыПартииПоКоду();
	КонецЕсли;

	Если Результат <> КодВозвратаДиалога.Да Тогда
		Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
			РежимИгры = "";
			ТипИгрыСетевой = "";
			СтатусПартии = "";
			ОтключитьОбработчикОжидания("ОпросПартииОбработчик");
			ОбновитьБлокировкуТипаИгрыНаСервере();
			ТекстСтатуса = "Партия завершена. Файл удалён. Можно создать новую.";
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если РежимИгры = "локально" Или РежимИгры = "бот" Или РежимИгры = "пасьянс" Или ПустаяСтрока(РежимИгры) Тогда
		Если РежимИгры = "бот" Тогда
			ИграСБотом(Неопределено);
		ИначеЕсли РежимИгры = "пасьянс" Или ТипИгры = "пасьянс" Тогда
			НачатьПасьянс();
		Иначе
			ЛокальнаяИгра(Неопределено);
		КонецЕсли;
	ИначеЕсли РежимИгры = "хост" Тогда
		СоздатьИгруЗавершение();
	ИначеЕсли РежимИгры = "гость" Тогда
		РежимИгры = "";
		ТипИгрыСетевой = "";
		СтатусПартии = "";
		ОтключитьОбработчикОжидания("ОпросПартииОбработчик");
		ОбновитьБлокировкуТипаИгрыНаСервере();
		ПоказатьПредупреждение(, "Файл старой партии удалён. Новую создаёт хост — затем нажмите «Подключиться».");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаНовыйПасьянс(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		НачатьПасьянс();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКликДуракаПоКоординатам(КодДействия, Параметр)

	// cell:90:N — карта руки, 91 — Бито/Пас, 92 — Взять, 94 — Сыграть выбранную.
	Если СтатусПартии <> "игра" Тогда
		Возврат;
	КонецЕсли;
	Если Не СейчасМойХод() Тогда
		Возврат;
	КонецЕсли;

	ЯИгрок0 = (МойИндексИгрока = 0);
	Если РежимИгры = "локально" Тогда
		ЯИгрок0 = ХодБелых;
		МойИндексКлик = ?(ХодБелых, 0, 1);
	ИначеЕсли РежимИгры = "бот" Тогда
		ЯИгрок0 = Истина;
		МойИндексКлик = 0;
	Иначе
		МойИндексКлик = МойИндексИгрока;
	КонецЕсли;

	Результат = ОбработатьКликДуракаНаСервере(Доска, ЯИгрок0, КодДействия, Параметр, МойИндексКлик);
	Если Не Результат.Ок Тогда
		Если Не ПустаяСтрока(Результат.Описание) Тогда
			ПоследнийХод = Результат.Описание;
			ОбновитьОтображение();
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Доска = Результат.Доска;
	СтатусПартии = Результат.Статус;
	Если Не ПустаяСтрока(Результат.Описание) Тогда
		ПоследнийХод = Результат.Описание;
	КонецЕсли;
	ХодБелых = ХодБелыхДуракаНаСервере(Доска);

	Если РежимИгры = "хост" Или РежимИгры = "гость" Тогда
		СохранитьПартиюПослеХода();
	КонецЕсли;

	ОбновитьОтображение();
	ПоказатьОкноПобедыЕслиНужно();
	ЗапланироватьХодБотаЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьКликПасьянсаПоКоординатам(КодЗоны, Параметр)

	// Коды как у шашек (cell:), чтобы поле HTML в 1С стабильно ловило клик:
	// 80 — сток, 81 — сброс, 82 — дом (параметр 0..3), 83..89 — стол 0..6 (параметр = индекс карты).
	Если РежимИгры <> "пасьянс" Или СтатусПартии <> "игра" Тогда
		Возврат;
	КонецЕсли;

	Зона = "";
	Колонка = 0;
	ИндексКарты = 0;
	Если КодЗоны = 80 Тогда
		Зона = "stock";
	ИначеЕсли КодЗоны = 81 Тогда
		Зона = "waste";
	ИначеЕсли КодЗоны = 82 Тогда
		Зона = "f";
		Колонка = Параметр;
	ИначеЕсли КодЗоны >= 83 И КодЗоны <= 89 Тогда
		Зона = "t";
		Колонка = КодЗоны - 83;
		ИндексКарты = Параметр;
	Иначе
		Возврат;
	КонецЕсли;

	Результат = ОбработатьКликПасьянсаНаСервере(Доска, ВыборПасьянса, Зона, Колонка, ИндексКарты);
	Если Не Результат.Ок Тогда
		Возврат;
	КонецЕсли;
	Если Результат.Доска <> Доска Тогда
		ЗапомнитьХодПасьянсаДляОтмены(Доска);
	КонецЕсли;
	Доска = Результат.Доска;
	ВыборПасьянса = Результат.Выбор;
	Если Не ПустаяСтрока(Результат.Описание) Тогда
		ПоследнийХод = Результат.Описание;
	КонецЕсли;
	СтатусПартии = Результат.Статус;
	ОбновитьОтображение();
	ПоказатьОкноПобедыЕслиНужно();

КонецПроцедуры

&НаКлиенте
Процедура ЗапомнитьХодПасьянсаДляОтмены(СостояниеДоски)

	ИсторияОтменыПасьянса.Добавить(СостояниеДоски);
	Пока ИсторияОтменыПасьянса.Количество() > 40 Цикл
		ИсторияОтменыПасьянса.Удалить(0);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ХодНазад(Команда)

	Если РежимИгры <> "пасьянс" Тогда
		ПоказатьПредупреждение(, "«Назад» работает только в пасьянсе.");
		Возврат;
	КонецЕсли;
	Если ИсторияОтменыПасьянса.Количество() = 0 Тогда
		ПоказатьПредупреждение(, "Нечего отменять — ходов ещё не было.");
		Возврат;
	КонецЕсли;

	Индекс = ИсторияОтменыПасьянса.Количество() - 1;
	Доска = ИсторияОтменыПасьянса[Индекс].Значение;
	ИсторияОтменыПасьянса.Удалить(Индекс);
	ВыборПасьянса = "";
	СтатусПартии = "игра";
	ПоследнийХод = "Отмена хода";
	ОбновитьОтображение();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлыПартииПоКоду()

	Если ПустаяСтрока(СокрЛП(ПутьКПапке)) Или ПустаяСтрока(СокрЛП(КодПартии)) Тогда
		Возврат;
	КонецЕсли;
	УдалитьФайлЕслиЕсть(ПутьФайлаПартииПоТипу("шашки"));
	УдалитьФайлЕслиЕсть(ПутьФайлаПартииПоТипу("шахматы"));
	УдалитьФайлЕслиЕсть(ПутьФайлаПартииПоТипу("дурак"));
	УдалитьФайлыПульсовПартии();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьФайлЕслиЕсть(ПутьФайла)

	Попытка
		Файл = Новый Файл(ПутьФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ПутьФайла);
		КонецЕсли;
	Исключение
		// Нет прав или файл занят — не прерываем игру.
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьПартиюПослеХода()

	Состояние = ПрочитатьСостояниеИзФайла();
	Если Состояние = Неопределено Тогда
		Состояние = СоздатьСостояниеПартииНаСервере(КодПартии, ИмяХоста, ОбязательноеВзятие, ТипИгры,
			РазмерКолодыЧислом(), ПереводнойДурак);
	КонецЕсли;

	Состояние.доска = Доска;
	Состояние.ходБелых = ХодБелых;
	Состояние.статус = СтатусПартии;
	Состояние.последнийХод = ПоследнийХод;
	Состояние.версия = Состояние.версия + 1;
	Состояние.имяХоста = ИмяХоста;
	Состояние.имяГостя = ИмяГостя;
	Состояние.Вставить("типИгры", ТипИгры);
	Состояние.Вставить("обязательноеВзятие", ОбязательноеВзятие);
	Состояние.Вставить("рокировка", РокировкаПрава);
	Состояние.Вставить("полеEP", ПолеEP);
	Состояние.Вставить("размерКолоды", РазмерКолодыЧислом());
	Состояние.Вставить("переводной", ПереводнойДурак);
	Если ТипИгры = "дурак" Тогда
		Состояние.Вставить("игроки", ИгрокиПартии(Состояние));
		Состояние.Вставить("максИгроков", 4);
	КонецЕсли;
	Если ЗаписатьСостояниеВФайл(Состояние) Тогда
		ВерсияПартии = Состояние.версия;
	КонецЕсли;

КонецПроцедуры

